<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_data"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

        <TextView
            android:id="@+id/connectionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data_waiting_connection" />

        <TextView
            android:id="@+id/metricEngineRpmValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RPM: —" />

        <TextView
            android:id="@+id/metricVehicleSpeedValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speed: —" />

        <TextView
            android:id="@+id/metricEngineTempValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coolant: —" />

        <TextView
            android:id="@+id/metricBatteryVoltageValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery: —" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openIssuesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_issues" />

    </LinearLayout>
</ScrollView>
