<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_daily_check_screen"
    android:padding="24dp"
    tools:context=".ui.dailycheck.DailyCheckProgressFragment">

    <TextView
        android:id="@+id/dailyCheckProgressTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/daily_check_progress_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/dc_text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/dailyCheckProgressIndicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        app:indicatorColor="@color/dc_button_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dailyCheckProgressTitle"
        app:trackColor="@color/dc_stroke" />

    <TextView
        android:id="@+id/dailyCheckProgressElapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/dc_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dailyCheckProgressIndicator"
        tools:text="Прошло: 8 c" />

    <LinearLayout
        android:id="@+id/dailyCheckProgressSteps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dailyCheckProgressElapsed">

        <TextView
            android:id="@+id/dailyCheckProgressStepConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="@string/daily_check_progress_step_connect"
            android:text="@string/daily_check_progress_step_connect"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/dc_text_primary" />

        <TextView
            android:id="@+id/dailyCheckProgressStepRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:tag="@string/daily_check_progress_step_read"
            android:text="@string/daily_check_progress_step_read"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/dc_text_primary" />

        <TextView
            android:id="@+id/dailyCheckProgressStepAnalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:tag="@string/daily_check_progress_step_analyze"
            android:text="@string/daily_check_progress_step_analyze"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/dc_text_primary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dailyCheckConnectionErrorCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_daily_check_card"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dailyCheckProgressSteps"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/dailyCheckConnectionErrorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/daily_check_connection_error_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/dc_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dailyCheckConnectionRetryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_daily_check_accent_button"
                android:text="@string/action_retry"
                android:textColor="@color/dc_button_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dailyCheckOpenLastResultButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/daily_check_open_last_result"
                android:textColor="@color/dc_text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
